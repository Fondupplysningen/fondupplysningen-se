---
import Bas from '../layouts/Bas.astro';
import heroBg from '../assets/hero-bg.jpg';

const title = 'Fondupplysningen — på väg 2026';
const description =
  'Oberoende information och analys om svenska fonder. Plattformen byggs just nu. På väg 2026.';
---

<Bas title={title} description={description} noindex>
  <div class="hero" style={`background-image: url(${heroBg.src});`}>
    <div class="top">
      <div class="headline">Du kan nå <em>längre</em></div>
      <p class="sub">Oberoende information och analys av svenska fonder</p>
    </div>

    <div class="bottom">
      <div class="brand">På väg 2026</div>

      <p class="contact">
        <a href="mailto:kontakt@fondupplysningen.se">kontakt@fondupplysningen.se</a>
      </p>
    </div>
  </div>
</Bas>

<style>
  .hero {
    min-height: 100vh;
    min-height: 100dvh;
    background-size: cover;
    background-position: center center;
    background-repeat: no-repeat;
    background-color: #d9c9b4;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    text-align: center;
    padding: clamp(34px, 6vh, 92px) 24px clamp(26px, 4vh, 54px);
  }

  .top,
  .bottom {
    width: 100%;
    opacity: 0;
    animation: rise 1.6s cubic-bezier(0.2, 0.7, 0.2, 1) 0.3s forwards;
  }
  .bottom {
    animation-delay: 0.55s;
  }

  .headline {
    font-family: 'Fraunces', serif;
    font-weight: 340;
    font-size: clamp(32px, 6vw, 96px);
    line-height: 1.04;
    letter-spacing: -0.02em;
    color: #2a2016;
    font-variation-settings: 'opsz' 144, 'SOFT' 60;
    text-shadow: 0 1px 28px rgba(245, 240, 230, 0.6);
  }
  .headline em {
    font-style: italic;
    font-weight: 320;
    color: #a86f28;
  }

  .sub {
    font-family: 'IBM Plex Sans', sans-serif;
    font-weight: 400;
    font-size: clamp(15px, 1.9vw, 20px);
    line-height: 1.5;
    color: #4a3d2c;
    max-width: 34ch;
    margin: 1.15rem auto 0;
    text-shadow: 0 1px 18px rgba(245, 240, 230, 0.6);
  }

  .bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.35rem;
  }

  .brand {
    font-family: 'Jost', sans-serif;
    font-weight: 400;
    font-size: clamp(12px, 1.6vw, 16px);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #4a3d2c;
    text-shadow: 0 1px 20px rgba(245, 240, 230, 0.6);
  }

  .contact {
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: clamp(14px, 1.6vw, 16px);
    color: #3a2f22;
    text-shadow: 0 1px 18px rgba(245, 240, 230, 0.6);
  }
  .contact a {
    color: #2a2016;
    text-decoration: none;
    font-weight: 500;
    border-bottom: 1.5px solid #a86f28;
    padding-bottom: 1px;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .contact a:hover {
    color: #c2553a;
    border-color: #c2553a;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (orientation: portrait) {
    .hero {
      background-size: cover;
      padding: clamp(34px, 6vh, 80px) 20px clamp(24px, 4vh, 48px);
    }
    .headline {
      font-size: clamp(38px, 11vw, 70px);
      line-height: 1;
    }
    .bottom {
      gap: 1.15rem;
    }
    .brand {
      letter-spacing: 0.2em;
    }
  }
</style>
